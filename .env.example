# UNLOCK environment variables
#
# Copy to .env.local and fill in real values for your own Supabase/Postgres
# project. Never commit .env.local (see .gitignore) or paste real values
# into chat/code review/AI tooling.

# --- Required at runtime ---

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - server-only, required for runtime PostgreSQL access
# (src/infrastructure/postgres/pg-pool.ts). Never expose this through
# NEXT_PUBLIC_*. Use the Supabase project's Postgres connection string
# (pooler or direct, per docs/DEV_STATUS.md's Postgres/Vercel notes).
DATABASE_URL=

# TLS root CA for the Supabase pooler (public certificate, not a secret; a
# connection failing with SELF_SIGNED_CERT_IN_CHAIN needs it). Download it
# from Supabase Dashboard -> Project Settings -> Database -> SSL Configuration.
# Certificate verification is always on (never disabled). Provide it ONE way:
#  - hosted (Vercel): DATABASE_SSL_CA = the PEM CONTENTS of that file
#    (multi-line, or one line with literal \n). Takes precedence, and no file is read.
#  - local: DATABASE_SSL_CA_FILE = path to the downloaded file, kept outside
#    version control (a repo-root /supabase-ca.crt is git-ignored).
# A local file path in DATABASE_URL's sslrootcert= parameter is still honored
# locally, but never use it on a hosted runtime. Never commit the file or credentials.
DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=

# Optional, server-only. Size of the per-process pg connection pool. Unset =
# 1 (default). Integer 1..10; anything else fails at startup with a config
# error. Raise it on a hosted platform that serves many concurrent requests
# from one warm instance (each instance holds up to this many connections to
# the Supabase Transaction Pooler, so keep it small).
# DATABASE_POOL_MAX=
# Optional. Set to exactly "true" to log at most one line/second of pool stats
# (max/totalCount/idleCount/waitingCount) while requests wait for a connection.
# DATABASE_POOL_LOG_STATS=

# --- Public / browser-safe Supabase configuration ---
# Both required for Supabase Auth (src/infrastructure/supabase/
# {browser,server}-client.ts). Public by design - the anon key is meant to
# be shipped to the browser, it is NOT a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets ---

# SUPABASE_SERVICE_ROLE_KEY is NOT required for the current user-auth flow
# (requireAuthenticatedUser uses only the anon key + the caller's own
# session). Reserved for a future admin/RLS-bypass use case. Server-side
# only - must NEVER be exposed client-side (never NEXT_PUBLIC_*, never sent
# to the browser in any response). Leave unset unless a specific use case
# requires it.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional / future ---

# AI - optional, no current in-product feature depends on this (Run 011
# PDF/AI content pipeline is future work).
# OPENAI_API_KEY=
