# UNLOCK environment variables

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - server-only, required for runtime PostgreSQL access
# (src/infrastructure/postgres/pg-pool.ts). Never expose this through
# NEXT_PUBLIC_*. Not yet configured against any real database.
# DATABASE_URL=

# Supabase - not yet configured against any real project. Both
# NEXT_PUBLIC_* vars below are required for Supabase Auth
# (src/infrastructure/supabase/{browser,server}-client.ts) and are public
# by design - the anon key is meant to be shipped to the browser, it is
# NOT a secret.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# SUPABASE_SERVICE_ROLE_KEY is NOT required for the user-auth flow above
# (requireAuthenticatedUser uses only the anon key + the caller's own
# session). Reserved for a future admin/RLS-bypass use case. Server-side
# only - must NEVER be exposed client-side (never NEXT_PUBLIC_*, never
# sent to the browser in any response).
# SUPABASE_SERVICE_ROLE_KEY=

# AI - optional
# OPENAI_API_KEY=
